# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง
# คำสั่ง:  cp .env.example .env      (Windows: copy .env.example .env)

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=itshop_user
DB_PASSWORD=itshop_pass
DB_NAME=itshop

# ห้ามใช้ค่านี้ตอนใช้งานจริง ให้สุ่มสตริงยาว ๆ มาใส่แทน
JWT_SECRET=change-this-secret-key
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
